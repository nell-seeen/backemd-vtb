<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="music_stream_prefs.xml" />
        <exclude domain="database" path="music_stream.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="music_stream_prefs.xml" />
        <include domain="database" path="music_stream.db" />
    </device-transfer>
</data-extraction-rules>
